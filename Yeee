<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no" />
  <title>Ohio Tools — Mobile Fix</title>
  <style>
    html,body{margin:0;height:100%;overflow:hidden;background:#87ceeb;font-family:Arial,Helvetica,sans-serif;-webkit-user-select:none;user-select:none}
    canvas{display:block}

    #hud{position:fixed;left:12px;top:12px;z-index:30;background:rgba(0,0,0,0.45);color:#fff;padding:10px;border-radius:8px;font-size:14px;min-width:220px}
    #hpbar{width:200px;height:16px;background:#441111;border-radius:8px;overflow:hidden;margin-top:6px}
    #hpfill{height:100%;background:#27d34d;width:100%;transition:width .12s}
    #slots{margin-top:8px;display:flex;gap:8px}
    .slot{flex:1;background:rgba(255,255,255,0.06);padding:8px;border-radius:6px;text-align:center}
    .selected{outline:3px solid #fff2;box-shadow:0 0 8px #ffe600 inset}

    #msg{position:fixed;left:50%;top:10%;transform:translateX(-50%);z-index:30;color:#fff;text-shadow:0 0 8px #000;font-size:18px}

    #start{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:40;background:rgba(0,0,0,0.35);touch-action:manipulation}
    #start .box{background:rgba(0,0,0,0.7);padding:24px;border-radius:12px;color:#fff;text-align:center;max-width:320px}

    /* left joystick area for mobile */
    #touchLeft{position:fixed;left:12px;bottom:12px;width:40%;height:40%;max-width:320px;max-height:320px;touch-action:none;z-index:35}
    .joyBase{position:absolute;left:0;bottom:0;width:140px;height:140px;border-radius:70px;background:rgba(0,0,0,0.25);display:flex;align-items:center;justify-content:center}
    .joyKnob{width:56px;height:56px;border-radius:28px;background:rgba(255,255,255,0.26);transform:translate(0,0)}

    /* right buttons */
    #touchRight{position:fixed;right:12px;bottom:12px;width:34%;height:40%;max-width:300px;max-height:300px;z-index:35}
    .btn{position:absolute;width:72px;height:72px;border-radius:36px;background:rgba(0,0,0,0.35);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}
    #btnJump{right:18px;bottom:18px}
    #btnUse{right:100px;bottom:18px}
    #btnSwap{right:18px;bottom:100px;width:56px;height:56px;border-radius:28px}

    #help{position:fixed;right:12px;top:12px;z-index:30;color:#eee;background:rgba(0,0,0,0.35);padding:8px;border-radius:8px;font-size:13px}

    @media (min-width:900px){ #touchLeft,#touchRight{display:none} }
  </style>
</head>
<body>
  <div id="hud">
    <div style="font-weight:700">OHIO TOOLS</div>
    <div>Health: <span id="hpText">100</span></div>
    <div id="hpbar"><div id="hpfill"></div></div>
    <div id="slots">
      <div id="slot0" class="slot">1: <span id="t0">—</span></div>
      <div id="slot1" class="slot">2: <span id="t1">—</span></div>
    </div>
  </div>

  <div id="help">WASD / Joystick • Tap right to look • 1/2 to switch • Jump</div>
  <div id="msg">Click / Tap to start</div>

  <div id="start" role="button" aria-label="Start game">
    <div class="box">
      <h2>Ohio Tools</h2>
      <p>Tap / Click to start — mobile and desktop supported</p>
      <p><b>Tap to start</b></p>
    </div>
  </div>

  <div id="touchLeft">
    <div class="joyBase" id="joyBase">
      <div class="joyKnob" id="joyKnob"></div>
    </div>
  </div>

  <div id="touchRight">
    <div id="btnUse" class="btn">USE</div>
    <div id="btnJump" class="btn">JUMP</div>
    <div id="btnSwap" class="btn">⇄</div>
  </div>

  <script type="importmap">
  {
    "imports": {
      "three": "https://unpkg.com/three@0.158.0/build/three.module.js"
    }
  }
  </script>

  <script type="module">
  import * as THREE from "three";
  import { PointerLockControls } from "https://unpkg.com/three@0.158.0/examples/jsm/controls/PointerLockControls.js";

  // ---- scene setup (same as before) ----
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x87ceeb);
  scene.fog = new THREE.Fog(0x87ceeb, 120, 360);

  const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 800);
  const renderer = new THREE.WebGLRenderer({ antialias:true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(innerWidth, innerHeight);
  document.body.appendChild(renderer.domElement);

  scene.add(new THREE.HemisphereLight(0xbfeaff, 0x445522, 1.3));
  const sun = new THREE.DirectionalLight(0xffffff, 1.6);
  sun.position.set(50,120,30);
  scene.add(sun);

  function mat(color){ return new THREE.MeshStandardMaterial({ color, roughness:0.8 }); }
  function boxMesh(c,x,y,z){ const m = new THREE.Mesh(new THREE.BoxGeometry(x,y,z), mat(c)); m.castShadow=true; m.receiveShadow=true; return m; }
  function sphereMesh(c,r){ const m = new THREE.Mesh(new THREE.SphereGeometry(r,16,12), mat(c)); m.castShadow=true; return m; }
  function cylinderMesh(c,r,h){ const m = new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,12), mat(c)); m.castShadow=true; return m; }

  const MAP_SIZE = 180, HALF = MAP_SIZE/2;
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(MAP_SIZE, MAP_SIZE), mat(0x2f7a3f));
  ground.rotation.x = -Math.PI/2; ground.receiveShadow=true; scene.add(ground);

  const wallH = 8;
  const wallC = 0x6b4226;
  scene.add(boxMesh(wallC, MAP_SIZE, wallH, 3)).position.set(0, wallH/2, -HALF);
  scene.add(boxMesh(wallC, MAP_SIZE, wallH, 3)).position.set(0, wallH/2, HALF);
  const west = boxMesh(wallC, 3, wallH, MAP_SIZE); west.position.set(-HALF, wallH/2, 0); scene.add(west);
  const east = boxMesh(wallC, 3, wallH, MAP_SIZE); east.position.set(HALF, wallH/2, 0); scene.add(east);

  for(let i=0;i<18;i++){
    const h = boxMesh(0xa95132, 8,7,8);
    const roof = new THREE.Mesh(new THREE.ConeGeometry(6,4,4), mat(0x54231d));
    const angle = (i/18)*Math.PI*2;
    const r = 62 + (i%2)*9;
    h.position.set(Math.cos(angle)*r, 3.5, Math.sin(angle)*r);
    roof.position.set(h.position.x, 8.5, h.position.z); roof.rotation.y = Math.PI/4;
    scene.add(h, roof);
  }

  const TOOLS = ["Hug Spoon", "Train Airstrike", "🗿 Moai", "Fizza Gun"];
  function randTool(){ return TOOLS[Math.floor(Math.random()*TOOLS.length)]; }
  function randTwo(){ return [randTool(), randTool()]; }

  // player (simple capsule-ish group)
  const player = { group:new THREE.Group(), pos:new THREE.Vector3(0,0,0), velY:0, onGround:true, speed:10, health:100, inv:randTwo(), selected:0, alive:true, tag:'player' };
  const torso = boxMesh(0x246bdb, 1.4, 1.8, 1.0);
  const head = sphereMesh(0x88c0ff, 0.45); head.position.set(0,1.45,0);
  const legL = cylinderMesh(0x123c8a, 0.12, 1.0); legL.position.set(-0.28,-0.5,0);
  const legR = cylinderMesh(0x123c8a, 0.12, 1.0); legR.position.set(0.28,-0.5,0);
  player.group.add(torso, head, legL, legR);
  player.group.position.set(0,1.0,0);
  scene.add(player.group);

  camera.position.set(0,1.6,5);

  const controls = new PointerLockControls(camera, renderer.domElement);

  // UI references
  const startEl = document.getElementById('start');
  const msgEl = document.getElementById('msg');

  // joystick elements
  const joyBase = document.getElementById('joyBase');
  const joyKnob = document.getElementById('joyKnob');
  const btnUse = document.getElementById('btnUse');
  const btnJump = document.getElementById('btnJump');
  const btnSwap = document.getElementById('btnSwap');
  let joyActive=false, joyId=null, joyStartX=0, joyStartY=0, joyVec={x:0,y:0};

  function resetJoy(){ joyKnob.style.transform='translate(0px,0px)'; joyVec={x:0,y:0}; }

  // attach joystick listeners (non-passive so preventDefault works)
  joyBase.addEventListener('touchstart', (e)=> {
    for (const t of e.changedTouches) {
      if (joyId === null) { joyId = t.identifier; joyActive = true; joyStartX = t.clientX; joyStartY = t.clientY; e.preventDefault(); break; }
    }
  }, { passive: false });

  joyBase.addEventListener('touchmove', (e)=> {
    for (const t of e.changedTouches) {
      if (t.identifier === joyId) {
        const dx = t.clientX - joyStartX, dy = t.clientY - joyStartY;
        const max = 56;
        const nx = Math.max(-1, Math.min(1, dx / max));
        const ny = Math.max(-1, Math.min(1, dy / max));
        joyVec = { x: nx, y: -ny };
        joyKnob.style.transform = `translate(${nx*40}px, ${-ny*40}px)`;
        e.preventDefault();
      }
    }
  }, { passive: false });

  joyBase.addEventListener('touchend', (e)=> {
    for (const t of e.changedTouches) {
      if (t.identifier === joyId) { joyId = null; joyActive = false; resetJoy(); e.preventDefault(); break; }
    }
  }, { passive: false });

  // buttons: touchstart
  btnUse.addEventListener('touchstart', (e)=> { e.preventDefault(); useTool(player, player.inv[player.selected]); });
  btnJump.addEventListener('touchstart', (e)=> { e.preventDefault(); doJump(player); });
  btnSwap.addEventListener('touchstart', (e)=> { e.preventDefault(); player.selected = 1 - player.selected; updateHUD(); });

  // desktop fallback for swap button click
  btnSwap.addEventListener('click', ()=> { player.selected = 1 - player.selected; updateHUD(); });

  // start handling: desktop tries pointer lock; mobile hides overlay and enables touch controls
  let started = false;
  function isMobile() {
    return ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
  }

  function startGame() {
    if (started) return;
    started = true;
    if (isMobile()) {
      // mobile: hide overlay and let the game run without pointer lock
      startEl.style.display = 'none';
      msgEl.style.display = 'none';
    } else {
      // desktop: request pointer lock (must be in user gesture)
      try {
        controls.lock();
      } catch (err) {
        // fallback: hide overlay anyway
        startEl.style.display = 'none';
        msgEl.style.display = 'none';
      }
    }
  }

  // handle click AND touchstart for the start overlay
  startEl.addEventListener('click', (e)=> { e.preventDefault(); startGame(); });
  startEl.addEventListener('touchstart', (e)=> { e.preventDefault(); startGame(); }, { passive: false });
