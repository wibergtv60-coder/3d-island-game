<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no" />
  <title>Ohio Tools — Mobile Fix</title>
  <style>
    html,body{margin:0;height:100%;overflow:hidden;background:#87ceeb;font-family:Arial,Helvetica,sans-serif;-webkit-user-select:none;user-select:none}
    canvas{display:block}

    #hud{position:fixed;left:12px;top:12px;z-index:30;background:rgba(0,0,0,0.45);color:#fff;padding:10px;border-radius:8px;font-size:14px;min-width:220px}
    #hpbar{width:200px;height:16px;background:#441111;border-radius:8px;overflow:hidden;margin-top:6px}
    #hpfill{height:100%;background:#27d34d;width:100%;transition:width .12s}
    #slots{margin-top:8px;display:flex;gap:8px}
    .slot{flex:1;background:rgba(255,255,255,0.06);padding:8px;border-radius:6px;text-align:center}
    .selected{outline:3px solid #fff2;box-shadow:0 0 8px #ffe600 inset}

    #msg{position:fixed;left:50%;top:10%;transform:translateX(-50%);z-index:30;color:#fff;text-shadow:0 0 8px #000;font-size:18px}

    #start{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:40;background:rgba(0,0,0,0.35);touch-action:manipulation}
    #start.hidden{display:none}
    #start .box{background:rgba(0,0,0,0.7);padding:24px;border-radius:12px;color:#fff;text-align:center;max-width:320px}

    /* left joystick area for mobile */
    #touchLeft{position:fixed;left:12px;bottom:12px;width:40%;height:40%;max-width:320px;max-height:320px;touch-action:none;z-index:35}
    .joyBase{position:absolute;left:0;bottom:0;width:140px;height:140px;border-radius:70px;background:rgba(0,0,0,0.25);display:flex;align-items:center;justify-content:center}
    .joyKnob{width:56px;height:56px;border-radius:28px;background:rgba(255,255,255,0.26);transform:translate(0,0)}

    /* right buttons */
    #touchRight{position:fixed;right:12px;bottom:12px;width:34%;height:40%;max-width:300px;max-height:300px;z-index:35}
    .btn{position:absolute;width:72px;height:72px;border-radius:36px;background:rgba(0,0,0,0.35);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;touch-action:manipulation;user-select:none}
    #btnJump{right:18px;bottom:18px}
    #btnUse{right:100px;bottom:18px}
    #btnSwap{right:18px;bottom:100px;width:56px;height:56px;border-radius:28px}

    #help{position:fixed;right:12px;top:12px;z-index:30;color:#eee;background:rgba(0,0,0,0.35);padding:8px;border-radius:8px;font-size:13px}

    @media (min-width:900px){ 
      #touchLeft,#touchRight{display:none}
      #help{display:none}
    }
  </style>
</head>
<body>
  <div id="hud">
    <div style="font-weight:700">OHIO TOOLS</div>
    <div>Health: <span id="hpText">100</span></div>
    <div id="hpbar"><div id="hpfill"></div></div>
    <div id="slots">
      <div id="slot0" class="slot">1: <span id="t0">—</span></div>
      <div id="slot1" class="slot">2: <span id="t1">—</span></div>
    </div>
  </div>

  <div id="help">WASD / Joystick • Tap to look • 1/2 to switch • SPACE/E to use</div>
  <div id="msg">Click / Tap to start</div>

  <div id="start" role="button" aria-label="Start game">
    <div class="box">
      <h2>Ohio Tools</h2>
      <p>Tap / Click to start — mobile and desktop supported</p>
      <p><b>Tap to start</b></p>
    </div>
  </div>

  <div id="touchLeft">
    <div class="joyBase" id="joyBase">
      <div class="joyKnob" id="joyKnob"></div>
    </div>
  </div>

  <div id="touchRight">
    <div id="btnUse" class="btn">USE</div>
    <div id="btnJump" class="btn">JUMP</div>
    <div id="btnSwap" class="btn">⇄</div>
  </div>

  <script type="importmap">
  {
    "imports": {
      "three": "https://unpkg.com/three@0.158.0/build/three.module.js"
    }
  }
  </script>

  <script type="module">
  import * as THREE from "three";
  import { PointerLockControls } from "https://unpkg.com/three@0.158.0/examples/jsm/controls/PointerLockControls.js";

  // ---- scene setup ----
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x87ceeb);
  scene.fog = new THREE.Fog(0x87ceeb, 120, 360);

  const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 800);
  const renderer = new THREE.WebGLRenderer({ antialias:true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(innerWidth, innerHeight);
  document.body.appendChild(renderer.domElement);

  scene.add(new THREE.HemisphereLight(0xbfeaff, 0x445522, 1.3));
  const sun = new THREE.DirectionalLight(0xffffff, 1.6);
  sun.position.set(50,120,30);
  scene.add(sun);

  function mat(color){ return new THREE.MeshStandardMaterial({ color, roughness:0.8 }); }
  function boxMesh(c,x,y,z){ const m = new THREE.Mesh(new THREE.BoxGeometry(x,y,z), mat(c)); m.castShadow=true; m.receiveShadow=true; return m; }
  function sphereMesh(c,r){ const m = new THREE.Mesh(new THREE.SphereGeometry(r,16,12), mat(c)); m.castShadow=true; return m; }
  function cylinderMesh(c,r,h){ const m = new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,12), mat(c)); m.castShadow=true; return m; }

  const MAP_SIZE = 180, HALF = MAP_SIZE/2;
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(MAP_SIZE, MAP_SIZE), mat(0x2f7a3f));
  ground.rotation.x = -Math.PI/2; ground.receiveShadow=true; scene.add(ground);

  const wallH = 8;
  const wallC = 0x6b4226;
  scene.add(boxMesh(wallC, MAP_SIZE, wallH, 3)).position.set(0, wallH/2, -HALF);
  scene.add(boxMesh(wallC, MAP_SIZE, wallH, 3)).position.set(0, wallH/2, HALF);
  const west = boxMesh(wallC, 3, wallH, MAP_SIZE); west.position.set(-HALF, wallH/2, 0); scene.add(west);
  const east = boxMesh(wallC, 3, wallH, MAP_SIZE); east.position.set(HALF, wallH/2, 0); scene.add(east);

  for(let i=0;i<18;i++){
    const h = boxMesh(0xa95132, 8,7,8);
    const roof = new THREE.Mesh(new THREE.ConeGeometry(6,4,4), mat(0x54231d));
    const angle = (i/18)*Math.PI*2;
    const r = 62 + (i%2)*9;
    h.position.set(Math.cos(angle)*r, 3.5, Math.sin(angle)*r);
    roof.position.set(h.position.x, 8.5, h.position.z); roof.rotation.y = Math.PI/4;
    scene.add(h, roof);
  }

  const TOOLS = ["Hug Spoon", "Train Airstrike", "🗿 Moai", "Fizza Gun"];
  function randTool(){ return TOOLS[Math.floor(Math.random()*TOOLS.length)]; }
  function randTwo(){ return [randTool(), randTool()]; }

  // player setup
  const player = { group:new THREE.Group(), pos:new THREE.Vector3(0,0,0), velY:0, onGround:true, speed:10, health:100, inv:randTwo(), selected:0, alive:true, tag:'player' };
  const torso = boxMesh(0x246bdb, 1.4, 1.8, 1.0);
  const head = sphereMesh(0x88c0ff, 0.45); head.position.set(0,1.45,0);
  const legL = cylinderMesh(0x123c8a, 0.12, 1.0); legL.position.set(-0.28,-0.5,0);
  const legR = cylinderMesh(0x123c8a, 0.12, 1.0); legR.position.set(0.28,-0.5,0);
  player.group.add(torso, head, legL, legR);
  player.group.position.set(0,1.0,0);
  scene.add(player.group);

  camera.position.set(0,1.6,5);

  const controls = new PointerLockControls(camera, renderer.domElement);

  // UI references
  const startEl = document.getElementById('start');
  const msgEl = document.getElementById('msg');

  // joystick elements
  const joyBase = document.getElementById('joyBase');
  const joyKnob = document.getElementById('joyKnob');
  const btnUse = document.getElementById('btnUse');
  const btnJump = document.getElementById('btnJump');
  const btnSwap = document.getElementById('btnSwap');

  let joyActive=false, joyId=null, joyStartX=0, joyStartY=0, joyVec={x:0,y:0};
  let lookStartX=0, lookStartY=0, isLooking=false, lookId=null;
  let msgTimer = null;
  const projectiles = [];
  const effects = [];

  function resetJoy(){ joyKnob.style.transform='translate(0px,0px)'; joyVec={x:0,y:0}; }
  function showMessage(text) {
    msgEl.textContent = text;
    msgEl.style.display = 'block';
    clearTimeout(msgTimer);
    msgTimer = setTimeout(() => {
      msgEl.style.display = 'none';
    }, 1400);
  }
  function addEffect(obj, life, velocity = null) {
    effects.push({ mesh: obj, life, maxLife: life, velocity: velocity || new THREE.Vector3() });
  }

  // Movement joystick listeners
  joyBase.addEventListener('touchstart', (e)=> {
    for (const t of e.changedTouches) {
      if (joyId === null) {
        joyId = t.identifier;
        joyActive = true;
        joyStartX = t.clientX;
        joyStartY = t.clientY;
        e.preventDefault();
        break;
      }
    }
  }, { passive: false });

  joyBase.addEventListener('touchmove', (e)=> {
    for (const t of e.changedTouches) {
      if (t.identifier === joyId) {
        const dx = t.clientX - joyStartX, dy = t.clientY - joyStartY;
        const max = 56;
        const nx = Math.max(-1, Math.min(1, dx / max));
        const ny = Math.max(-1, Math.min(1, dy / max));
        joyVec = { x: nx, y: -ny };
        joyKnob.style.transform = `translate(${nx*40}px, ${-ny*40}px)`;
        e.preventDefault();
      }
    }
  }, { passive: false });

  joyBase.addEventListener('touchend', (e)=> {
    for (const t of e.changedTouches) {
      if (t.identifier === joyId) {
        joyId = null;
        joyActive = false;
        resetJoy();
        e.preventDefault();
        break;
      }
    }
  }, { passive: false });

  // Look control: swipe anywhere on screen (except buttons)
  document.addEventListener('touchstart', (e)=> {
    const touch = e.touches[0];
    const btnArea = document.getElementById('touchRight');
    const rect = btnArea.getBoundingClientRect();

    if (!(touch.clientX >= rect.left && touch.clientX <= rect.right &&
          touch.clientY >= rect.top && touch.clientY <= rect.bottom)) {
      if (!isLooking) {
        lookId = e.touches[0].identifier;
        isLooking = true;
        lookStartX = touch.clientX;
        lookStartY = touch.clientY;
      }
    }
  }, { passive: true });

  document.addEventListener('touchmove', (e)=> {
    if (isLooking && controls.isLocked) {
      for (const t of e.touches) {
        if (t.identifier === lookId) {
          const deltaX = t.clientX - lookStartX;
          const deltaY = t.clientY - lookStartY;

          const euler = new THREE.Euler(0, 0, 0, 'YXZ');
          euler.setFromQuaternion(camera.quaternion);
          euler.setFromVector3(new THREE.Vector3(
            euler.x - (deltaY * 0.003),
            euler.y - (deltaX * 0.003),
            0
          ));
          camera.quaternion.setFromEuler(euler);

          lookStartX = t.clientX;
          lookStartY = t.clientY;
          e.preventDefault();
          break;
        }
      }
    }
  }, { passive: false });

  document.addEventListener('touchend', (e)=> {
    for (const t of e.changedTouches) {
      if (t.identifier === lookId) {
        lookId = null;
        isLooking = false;
        break;
      }
    }
  }, { passive: true });

  // Action buttons
  btnUse.addEventListener('touchstart', (e)=> { e.preventDefault(); useTool(player, player.inv[player.selected]); });
  btnUse.addEventListener('click', ()=> { useTool(player, player.inv[player.selected]); });
  btnJump.addEventListener('touchstart', (e)=> { e.preventDefault(); doJump(player); });
  btnSwap.addEventListener('touchstart', (e)=> { e.preventDefault(); player.selected = 1 - player.selected; updateHUD(); });
  btnSwap.addEventListener('click', ()=> { player.selected = 1 - player.selected; updateHUD(); });

  // Device detection and start handling
  let started = false;
  function isMobile() {
    return ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
  }

  function startGame() {
    if (started) return;
    started = true;
    startEl.classList.add('hidden');
    msgEl.style.display = 'none';

    if (!isMobile()) {
      try {
        controls.lock();
      } catch (err) {
        console.warn('Pointer lock failed:', err);
      }
    } else {
      controls.isLocked = true;
    }
  }

  // Start overlay events
  startEl.addEventListener('click', (e)=> { e.preventDefault(); startGame(); });
  startEl.addEventListener('touchstart', (e)=> { e.preventDefault(); startGame(); }, { passive: false });

  function useTool(targetPlayer, tool) {
    if (!tool) {
      showMessage('No tool selected');
      return;
    }

    const origin = targetPlayer.group.position.clone().add(new THREE.Vector3(0, 1.25, 0));
    const dir = new THREE.Vector3();
    camera.getWorldDirection(dir);
    dir.y = 0.1;
    const fwd = dir.clone().normalize();

    if (tool === 'Hug Spoon') {
      const healAmount = Math.min(20, 100 - targetPlayer.health);
      targetPlayer.health = Math.min(100, targetPlayer.health + 20);
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(1.8, 0.14, 12, 36),
        new THREE.MeshStandardMaterial({ color: 0xffeb8e, emissive: 0xffcf33, emissiveIntensity: 0.7 })
      );
      ring.position.copy(origin);
      ring.rotation.x = Math.PI / 2;
      scene.add(ring);
      addEffect(ring, 0.7, new THREE.Vector3(0, 0.2, 0));
      showMessage(`Hug Spoon! +${healAmount} HP`);
    }

    if (tool === 'Train Airstrike') {
      const target = origin.clone().add(fwd.clone().multiplyScalar(18));
      target.y = 1.2;
      const blast = new THREE.Mesh(
        new THREE.CylinderGeometry(1.2, 1.8, 2.2, 16),
        new THREE.MeshStandardMaterial({ color: 0x2b2b2b, emissive: 0xff7a00, emissiveIntensity: 0.6 })
      );
      blast.position.copy(target);
      blast.rotation.x = Math.PI / 2;
      scene.add(blast);
      addEffect(blast, 0.8);
      showMessage('Train Airstrike incoming!');
    }

    if (tool === '🗿 Moai') {
      const statuePos = origin.clone().add(fwd.clone().multiplyScalar(7));
      statuePos.y = 0;
      const statue = new THREE.Group();
      const base = boxMesh(0xc3b39d, 1.8, 0.7, 1.8); base.position.y = 0.35;
      const torso = boxMesh(0xe2ddd0, 1.2, 2.2, 0.9); torso.position.y = 2.1;
      const head = sphereMesh(0xf4f0e5, 0.55); head.position.y = 3.7;
      statue.add(base, torso, head);
      statue.position.copy(statuePos);
      scene.add(statue);
      addEffect(statue, 2.2);
      showMessage('Moai summoned!');
    }

    if (tool === 'Fizza Gun') {
      const muzzle = origin.clone().add(fwd.clone().multiplyScalar(1.2));
      const pellet = new THREE.Mesh(
        new THREE.SphereGeometry(0.2, 10, 10),
        new THREE.MeshStandardMaterial({ color: 0xffd260, emissive: 0xff8a00, emissiveIntensity: 0.7 })
      );
      pellet.position.copy(muzzle);
      scene.add(pellet);
      projectiles.push({ mesh: pellet, velocity: fwd.clone().multiplyScalar(26), life: 1.7 });
      showMessage('Fizza Gun fired!');
    }

    updateHUD();
  }

  function doJump(playerObj) {
    if (playerObj.onGround) {
      playerObj.velY = 15;
      playerObj.onGround = false;
    }
  }

  function updateHUD() {
    document.getElementById('t0').textContent = player.inv[0] || '—';
    document.getElementById('t1').textContent = player.inv[1] || '—';
    document.getElementById('slot0').classList.toggle('selected', player.selected === 0);
    document.getElementById('slot1').classList.toggle('selected', player.selected === 1);

    const hp = Math.max(0, Math.min(100, player.health));
    document.getElementById('hpText').textContent = Math.ceil(hp);
    document.getElementById('hpfill').style.width = `${hp}%`;
    document.getElementById('hpfill').style.background = hp > 50 ? '#27d34d' : hp > 25 ? '#f2b600' : '#e3342f';
  }

  // Keyboard controls for desktop
  const keys = {};
  window.addEventListener('keydown', (e)=> { keys[e.key.toLowerCase()] = true; });
  window.addEventListener('keyup', (e)=> { keys[e.key.toLowerCase()] = false; });

  // Main game loop
  function animate() {
    requestAnimationFrame(animate);

    if (!started) {
      renderer.render(scene, camera);
      return;
    }

    if (controls.isLocked || isMobile()) {
      const forward = (keys['w'] || joyVec.y > 0.2) ? joyVec.y : (keys['w'] ? 1 : 0);
      const backward = (keys['s'] || joyVec.y < -0.2) ? -joyVec.y : (keys['s'] ? -1 : 0);
      const left = (keys['a'] || joyVec.x < -0.2) ? -joyVec.x : (keys['a'] ? -1 : 0);
      const right = (keys['d'] || joyVec.x > 0.2) ? joyVec.x : (keys['d'] ? 1 : 0);

      const direction = new THREE.Vector3();
      camera.getWorldDirection(direction);
      direction.y = 0; direction.normalize();
      const right_vec = new THREE.Vector3().crossVectors(camera.up, direction).normalize();

      const moveDir = new THREE.Vector3();
      moveDir.addScaledVector(direction, forward + backward);
      moveDir.addScaledVector(right_vec, left + right);
      moveDir.normalize().multiplyScalar(player.speed * 0.016);

      player.pos.add(moveDir);
    }

    // Gravity
    player.velY -= 9.8 * 0.016;
    player.pos.y += player.velY * 0.016;

    if (player.pos.y < 0) {
      player.pos.y = 0;
      player.velY = 0;
      player.onGround = true;
    }

    player.group.position.copy(player.pos);
    camera.position.set(player.pos.x, player.pos.y + 1.6, player.pos.z);

    // Handle keyboard shortcuts
    if (keys['1']) { player.selected = 0; updateHUD(); keys['1'] = false; }
    if (keys['2']) { player.selected = 1; updateHUD(); keys['2'] = false; }
    if (keys['e']) { useTool(player, player.inv[player.selected]); keys['e'] = false; }
    if (keys[' ']) { doJump(player); keys[' '] = false; }

    for (let i = projectiles.length - 1; i >= 0; i--) {
      const shot = projectiles[i];
      shot.mesh.position.addScaledVector(shot.velocity, 0.016);
      shot.life -= 0.016;
      if (shot.life <= 0 || shot.mesh.position.length() > 240) {
        scene.remove(shot.mesh);
        projectiles.splice(i, 1);
      }
    }

    for (let i = effects.length - 1; i >= 0; i--) {
      const fx = effects[i];
      fx.life -= 0.016;
      fx.mesh.rotation.y += 0.06;
      fx.mesh.scale.multiplyScalar(1.025);
      if (fx.velocity) {
        fx.mesh.position.addScaledVector(fx.velocity, 0.016);
      }
      if (fx.life <= 0) {
        scene.remove(fx.mesh);
        effects.splice(i, 1);
      }
    }

    renderer.render(scene, camera);
  }

  updateHUD();
  animate();
  </script>
</body>
</html>
